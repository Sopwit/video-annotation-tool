{
  "name": "video-annotation-tool",
  "private": true,
  "productName": "Video Annotation Tool",
  "desktopName": "com.sopwit.videoannotationtool.desktop",
  "version": "1.0.1",
  "description": "A powerful cross-platform video annotation tool for macOS, Windows, and Linux",
  "license": "MIT",
  "author": {
    "name": "Sopwit",
    "email": "sopwith.osdev@gmail.com"
  },
  "main": "backend/main.cjs",
  "homepage": "https://github.com/Sopwit/video-annotation-tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sopwit/video-annotation-tool.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "clean": "bash scripts/clean.sh",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.js",
    "icons:generate": "bash build/generate-icons.sh",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:all": "npm run build && electron-builder -mwl",
    "electron:package": "electron-builder --publish never"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.0",
    "react-player": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.sopwit.videoannotationtool",
    "productName": "Video Annotation Tool",
    "asar": true,
    "files": [
      "dist/**/*",
      "backend/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Video Annotation Tool",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "AudioVideo",
      "executableName": "video-annotation-tool",
      "syncDesktopName": true,
      "maintainer": "Sopwit <sopwith.osdev@gmail.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
